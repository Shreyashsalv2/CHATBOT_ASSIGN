# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2,your-gemini-key-3
# LiteLLM model name used by every key
LLM_MODEL=gemini/gemini-3.5-flash-lite
# SQLite location (inside Docker this is the named volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header
ENABLE_FAILURE_SIMULATION=true
# Optional: default system prompt and per-call timeout (seconds)
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_S=30
# Frontend build-time setting: where the browser reaches the backend
VITE_API_BASE_URL=http://localhost:8000
